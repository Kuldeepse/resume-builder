# CogniTwist frontend/server routes

# Server-only storage / admin values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
CAREER_NETWORK_ADMIN_ACCESS_CODE=replace-with-long-random-access-code
CAREER_NETWORK_ADMIN_SESSION_SECRET=replace-with-independent-random-session-secret
CAREER_NETWORK_ALLOWED_ORIGINS=https://cognitwistai.duckdns.org

# Optional V3 market-discovery worker. These MUST remain server-only;
# do not rename them with a NEXT_PUBLIC_ prefix.
MARKET_DISCOVERY_WORKER_URL=https://your-discovery-worker.example.com/
MARKET_DISCOVERY_WORKER_TOKEN=replace-with-long-random-worker-token

# Public metadata only
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_DATA_CONTROLLER_NAME=CogniTwist AI
